<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version Condition="'$(Edition)' == 'Simple'">1.1.2</Version>
    <Version Condition="'$(Edition)' == 'Full'">2.0.2</Version>
    <Product Condition="'$(Edition)' == 'Simple'">IME Layout Router V1 日本語簡易版</Product>
    <Product Condition="'$(Edition)' == 'Full'">IME Layout Router V2 Full</Product>
    <Version Condition="'$(Edition)' == 'Guard'">3.0.0-preview.1</Version>
    <Product Condition="'$(Edition)' == 'Guard'">IME Layout Router V3 Composition Guard Preview</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="Editions\**\*.cs" />
    <!-- Ship user-facing documentation only; development records stay in Git. -->
    <Content Include="README.md;CHANGELOG.md;SECURITY.md;docs\releases\history.md;docs\releases\v1-1.1.0.md;docs\releases\v1-1.1.0.en.md;docs\releases\v1-1.1.1.md;docs\releases\v1-1.1.1.en.md;docs\releases\v1-1.1.2.md;docs\releases\v1-1.1.2.en.md;docs\releases\v2-2.0.0.md;docs\releases\v2-2.0.0.en.md;docs\releases\v2-2.0.1.md;docs\releases\v2-2.0.1.en.md;docs\releases\v2-2.0.2.md;docs\releases\v2-2.0.2.en.md">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(Edition)' == 'Simple'">
    <Compile Remove="Program.cs;SettingsForm.cs;TrayApplicationContext.cs;GlobalHotkeys.cs;ForegroundApplication.cs;RoutingSession.cs;ConsoleProfileSelector.cs" />
    <Compile Include="Editions\Simple\*.cs" />
  </ItemGroup>
  <Target Name="ValidateEdition" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Edition)' != 'Simple' and '$(Edition)' != 'Full' and '$(Edition)' != 'Guard'" Text="Edition must be Simple, Full or Guard." />
  </Target>
  <ItemGroup Condition="'$(Edition)' == 'Guard'">
    <Compile Remove="*.cs" />
    <Compile Include="Editions\Guard\*.cs" />
  </ItemGroup>

</Project>
