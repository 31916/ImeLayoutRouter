<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version Condition="'$(Edition)' == 'Simple'">1.1.0</Version>
    <Version Condition="'$(Edition)' == 'Full'">2.0.0</Version>
    <Product Condition="'$(Edition)' == 'Simple'">IME Layout Router V1 日本語簡易版</Product>
    <Product Condition="'$(Edition)' == 'Full'">IME Layout Router V2 Full</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="Editions\**\*.cs" />
    <Content Include="README.md;CHANGELOG.md;docs\*.md">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(Edition)' == 'Simple'">
    <Compile Remove="Program.cs;SettingsForm.cs;TrayApplicationContext.cs;GlobalHotkeys.cs;ForegroundApplication.cs;RoutingSession.cs;ConsoleProfileSelector.cs" />
    <Compile Include="Editions\Simple\*.cs" />
  </ItemGroup>
  <Target Name="ValidateEdition" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Edition)' != 'Simple' and '$(Edition)' != 'Full'" Text="Edition must be Simple or Full." />
  </Target>

</Project>
