<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../*.cs" Exclude="../../Program.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Edition)' == 'Simple'">
    <Compile Remove="../../SettingsForm.cs;../../TrayApplicationContext.cs;../../GlobalHotkeys.cs;../../ForegroundApplication.cs;../../RoutingSession.cs;../../ConsoleProfileSelector.cs" />
    <Compile Include="../../Editions/Simple/SettingsForm.cs;../../Editions/Simple/TrayApplicationContext.cs" />
  </ItemGroup>
</Project>
